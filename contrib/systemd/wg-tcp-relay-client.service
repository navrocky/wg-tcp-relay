# wg-tcp-relay client: runs on the entry server, the address WireGuard peers connect to.
# Settings: /etc/wg-tcp-relay/client.env (see docs/configuration.md).
[Unit]
Description=wg-tcp-relay client (WireGuard peers -> TCP)
Documentation=https://github.com/navrocky/wg-tcp-relay
After=network-online.target wg-tcp-relay-tunnel.service
Wants=network-online.target

[Service]
Environment=WGTR_LISTEN=0.0.0.0:51820
Environment=WGTR_CONNECT=127.0.0.1:5000
EnvironmentFile=-/etc/wg-tcp-relay/client.env
ExecStart=/usr/local/bin/wg-tcp-relay client
Restart=always
RestartSec=2

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
